/* Behavior Designer 风格近似：深色网格画布 + 深色节点 */

GridBackground {
    --grid-background-color: rgb(46, 46, 46);
    --line-color: rgba(255, 255, 255, 0.06);
    --thick-line-color: rgba(255, 255, 255, 0.1);
    --spacing: 20;
}

.bt-graph {
    background-color: rgb(46, 46, 46);
    flex-grow: 1;
}

.bt-node {
    min-width: 150px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(20, 20, 20);
    background-color: rgb(70, 70, 70);
}

.bt-node #title {
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.bt-node #contents {
    background-color: rgb(70, 70, 70);
}

.bt-node #selection-border {
    border-radius: 3px;
}

.bt-node:selected {
    border-color: rgb(242, 198, 56);
    border-width: 2px;
}

.bt-node.bt-running {
    border-color: rgb(115, 217, 90);
    border-width: 2px;
}

.bt-composite #title {
    background-color: rgb(56, 107, 158);
}

.bt-decorator #title {
    background-color: rgb(107, 82, 133);
}

.bt-condition #title {
    background-color: rgb(64, 122, 71);
}

.bt-task #title {
    background-color: rgb(158, 107, 46);
}

.bt-category-badge {
    color: rgba(220, 220, 220, 0.75);
    font-size: 10px;
    -unity-font-style: normal;
    margin-left: 6px;
    margin-bottom: 4px;
    margin-top: 2px;
}

/* UE 风格：装饰叠在宿主顶部 */
.bt-decorator-stack {
    flex-direction: column;
    align-items: stretch;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 2px;
    background-color: rgb(36, 36, 36);
}

.bt-decorator-chip {
    height: 18px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    border-width: 1px;
    border-color: rgb(20, 20, 20);
}

.bt-decorator-chip-condition {
    background-color: rgb(64, 122, 71);
}

.bt-decorator-chip-structural {
    background-color: rgb(107, 82, 133);
}

.bt-decorator-chip-selected {
    border-color: rgb(242, 198, 56);
    border-width: 2px;
}

.bt-toolbar {
    background-color: rgb(41, 41, 41);
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 20, 20);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    flex-direction: row;
    flex-shrink: 0;
}

.bt-side-panel {
    background-color: rgb(41, 41, 41);
    border-right-width: 1px;
    border-right-color: rgb(20, 20, 20);
    width: 168px;
    padding: 6px;
}

.bt-inspector-panel {
    background-color: rgb(41, 41, 41);
    border-left-width: 1px;
    border-left-color: rgb(20, 20, 20);
    width: 300px;
}

.bt-panel-title {
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 6px;
    margin-top: 2px;
}

.bt-legend-row {
    flex-direction: row;
    margin-bottom: 4px;
    align-items: center;
}

.bt-legend-swatch {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    border-radius: 2px;
}

.bt-hint {
    color: rgba(180, 180, 180, 0.85);
    font-size: 10px;
    white-space: normal;
    margin-top: 8px;
}

.bt-status {
    color: rgb(180, 180, 180);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin-left: 8px;
    flex-grow: 1;
}
